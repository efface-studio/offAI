{
  "name": "@offai/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/worker.js",
    "setup:agents": "tsx --env-file-if-exists=../../.env src/setup.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@octokit/auth-app": "^8.0.0",
    "@octokit/rest": "^22.0.0",
    "@offai/core": "workspace:*",
    "@offai/db": "workspace:*",
    "fastify": "^5.12.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12"
  }
}
