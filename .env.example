# 로컬 개발용 예시. 실제 값은 .env 에 넣고 커밋하지 않는다.

# Postgres (docker compose -p offai up -d)
DATABASE_URL=postgres://offai:offai_dev@localhost:55433/offai

# Anthropic — SDK 가 ANTHROPIC_API_KEY 또는 `ant auth login` 프로필을 읽는다
ANTHROPIC_API_KEY=

# GitHub App (docs/setup.md 참고)
GITHUB_APP_ID=
# PEM 전체. 한 줄로 넣을 때는 줄바꿈을 \n 으로 적는다
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# worker
OFFAI_TRIGGER_LABEL=offai
OFFAI_ASSIGNEE=xixn2
WORKER_PORT=4445
MAX_CONCURRENCY=2
# 0 이면 정기 점검 끔. 24 면 하루 한 번 운영팀 점검
OPERATE_INTERVAL_HOURS=0
SESSION_TIMEOUT_MINUTES=90

# web 콘솔 관리자 비밀번호 (production 에서는 필수)
OFFAI_ADMIN_PASSWORD=
